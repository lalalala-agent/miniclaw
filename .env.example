# 复制此文件为仓库根目录的 .env 并填入你的值
# 启动：uv run python -m src
# 当前供应商由 MODEL_PROVIDER 决定，缺省 openai
# 启用哪些通道由 CHANNELS 决定

# 必填：要启动的通道，逗号分隔。已登记 cli、telegram
CHANNELS=cli

# telegram 通道必填：Bot Token（从 @BotFather 获取）
TELEGRAM_BOT_TOKEN=

# telegram 通道必填：你的 Telegram 用户 ID（从 @userinfobot 获取）
OWNER_ID=

# 可选：模型供应商。openai 或 vllm，缺省 openai
# MODEL_PROVIDER=openai

# openai 供应商必填：OpenAI API Key。vllm 不需要
OPENAI_API_KEY=

# openai 可选：自定义 OpenAI 兼容 API 端点（Responses API）
# OPENAI_BASE_URL=https://api.openai.com/v1

# openai 可选：模型名称（默认 gpt-4.1）
# OPENAI_MODEL=gpt-4.1

# vllm 必填：端点。SDK 会在后面拼 responses
# VLLM_BASE_URL=http://127.0.0.1:8000/v1

# vllm 可选
# VLLM_API_KEY=empty
# VLLM_MODEL=Qwen3.6
# 思考保持开启，只限制 token 数（默认 1024）
# THINKING_TOKEN_BUDGET=1024

# 可选：助手名称（默认 Ape）
# ASSISTANT_NAME=Ape

# 可选：调度时区（IANA 名称，默认 UTC；中国可用 Asia/Shanghai）
# TIMEZONE=Asia/Shanghai

# 可选：调度器检查间隔，单位秒（默认 60）
# SCHEDULER_INTERVAL=60

# 可选：知识库目录，必须在 workspace 里面（默认 workspace/wiki）
# WIKI_PATH=wiki

# 可选：千帆网页搜索 MCP。不填则跳过，不影响启动
QIANFAN_API_KEY=
